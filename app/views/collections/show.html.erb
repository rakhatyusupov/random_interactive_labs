<div style="max-width: 900px; margin: 0 auto;">
  <% if @collection.cover_image.attached? %>
    <%= image_tag @collection.cover_image.variant(resize_to_limit: [900, 600]), style: "width: 100%; border-radius: 8px; margin-bottom: 2rem;" %>
  <% end %>

  <h1 style="margin-bottom: 1rem;"><%= @collection.title %></h1>

  <div style="color: #666; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid #eee;">
    <p style="margin-bottom: 0.5rem;">
      by <%= link_to "@#{@collection.user.username}", profile_path(@collection.user.username) %>
      • Created <%= @collection.created_at.strftime("%B %d, %Y") %>
    </p>
    
    <% if @collection.description.present? %>
      <p style="margin-top: 1rem;"><%= @collection.description %></p>
    <% end %>
    
    <% if @collection.tags.any? %>
      <div style="margin-top: 0.5rem;">
        <% @collection.tags.each do |tag| %>
          <span style="display: inline-block; background: #e9ecef; padding: 0.3rem 0.6rem; border-radius: 4px; font-size: 0.9rem; margin-right: 0.5rem;">
            <%= tag.name %>
          </span>
        <% end %>
      </div>
    <% end %>
  </div>

  <h2 style="margin-bottom: 1.5rem;">Items (<%= @collection_items.count %>)</h2>

  <div style="display: grid; gap: 1.5rem;">
    <% @collection_items.each do |item| %>
      <div style="border: 1px solid #ddd; padding: 1.5rem; border-radius: 8px; background: #fafafa;">
        <div style="display: flex; justify-content: space-between; align-items: start;">
          <div style="flex: 1;">
            <span style="display: inline-block; background: #007bff; color: white; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.75rem; margin-bottom: 0.5rem; text-transform: uppercase;">
              <%= item.item_type %>
            </span>
            
            <h3 style="margin: 0.5rem 0;"><%= item.title %></h3>
            
            <% if item.url.present? %>
              <p><a href="<%= item.url %>" target="_blank" style="color: #007bff;"><%= item.url %></a></p>
            <% end %>
            
            <% if item.content.present? %>
              <p style="color: #555; margin-top: 0.5rem;"><%= item.content %></p>
            <% end %>
            
            <% if item.file.attached? %>
              <p style="margin-top: 0.5rem;">
                <%= link_to "Download", rails_blob_path(item.file, disposition: "attachment"), style: "color: #007bff;" %>
              </p>
            <% end %>
          </div>
          
          <% if user_signed_in? && (current_user == @collection.user || current_user.admin?) %>
            <%= button_to "Remove", collection_collection_item_path(@collection, item), method: :delete, data: { turbo_confirm: "Remove this item?" }, style: "background: #dc3545; color: white; border: none; padding: 0.5rem 1rem; border-radius: 4px; cursor: pointer; margin-left: 1rem;" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <% if @collection_items.empty? %>
    <p style="text-align: center; color: #666; padding: 3rem;">No items in this collection yet.</p>
  <% end %>

  <% if user_signed_in? && (current_user == @collection.user || current_user.admin?) %>
    <div style="margin-top: 3rem; padding: 2rem; background: #f8f9fa; border-radius: 8px;">
      <h3 style="margin-bottom: 1rem;">Add Item to Collection</h3>
      <%= form_with model: [@collection, @collection.collection_items.build], local: true do |form| %>
        <div style="display: grid; gap: 1rem;">
          <div>
            <%= form.label :item_type, "Type", style: "display: block; font-weight: bold; margin-bottom: 0.5rem;" %>
            <%= form.select :item_type, CollectionItem::ITEM_TYPES, {}, style: "padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px; width: 100%;" %>
          </div>
          
          <div>
            <%= form.label :title, style: "display: block; font-weight: bold; margin-bottom: 0.5rem;" %>
            <%= form.text_field :title, style: "width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px;" %>
          </div>
          
          <div>
            <%= form.label :url, "URL (for links)", style: "display: block; font-weight: bold; margin-bottom: 0.5rem;" %>
            <%= form.text_field :url, style: "width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px;" %>
          </div>
          
          <div>
            <%= form.label :content, "Text content", style: "display: block; font-weight: bold; margin-bottom: 0.5rem;" %>
            <%= form.text_area :content, rows: 4, style: "width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px;" %>
          </div>
          
          <div>
            <%= form.label :file, "Upload file", style: "display: block; font-weight: bold; margin-bottom: 0.5rem;" %>
            <%= form.file_field :file, style: "width: 100%;" %>
          </div>
          
          <%= form.submit "Add Item", style: "padding: 0.75rem 2rem; background: #28a745; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 1rem;" %>
        </div>
      <% end %>
    </div>

    <div style="margin-top: 2rem;">
      <%= link_to "Edit Collection", edit_collection_path(@collection), style: "padding: 0.5rem 1rem; background: #007bff; color: white; text-decoration: none; border-radius: 4px; margin-right: 0.5rem;" %>
      <%= button_to "Delete Collection", @collection, method: :delete, data: { turbo_confirm: "Are you sure?" }, style: "display: inline;", form: { style: "display: inline;" } %>
    </div>
  <% end %>
</div>
