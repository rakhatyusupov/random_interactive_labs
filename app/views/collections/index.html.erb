<h1>Collections</h1>

<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 2rem; margin-top: 2rem;">
  <% @collections.each do |collection| %>
    <article style="border: 1px solid #ddd; padding: 1rem; border-radius: 8px;">
      <h2 style="margin: 0 0 0.5rem 0;">
        <%= link_to collection.title, collection, style: "text-decoration: none; color: #333;" %>
      </h2>
      
      <p style="color: #666; font-size: 0.9rem; margin-bottom: 0.5rem;">
        by <%= link_to "@#{collection.user.username}", profile_path(collection.user.username) %>
      </p>
      
      <% if collection.description.present? %>
        <p style="color: #555; margin-bottom: 0.5rem;"><%= truncate(collection.description, length: 150) %></p>
      <% end %>
      
      <% if collection.tags.any? %>
        <div style="margin-top: 0.5rem;">
          <% collection.tags.each do |tag| %>
            <span style="display: inline-block; background: #e9ecef; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.8rem; margin-right: 0.5rem;">
              <%= tag.name %>
            </span>
          <% end %>
        </div>
      <% end %>
    </article>
  <% end %>
</div>

<% if @collections.empty? %>
  <p style="text-align: center; color: #666; margin-top: 3rem;">No collections yet.</p>
<% end %>
