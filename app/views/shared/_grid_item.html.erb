<%# locals: (item:) %>

<% 
  # Random span between 1-3 for variety
  span = [1, 2, 2, 3].sample
  is_article = item.is_a?(Article)
  is_collection = item.is_a?(Collection)
  
  title = is_article ? item.title : item.title
  path = is_article ? article_path(item) : collection_path(item)
  image = item.cover_image if item.respond_to?(:cover_image) && item.cover_image.attached?
%>

<article class="border border-gray-800 bg-white col-span-<%= span %>" data-grid-item data-span="<%= span %>">
  <!-- Image -->
  <div class="w-full">
    <% if image %>
      <%= link_to path, class: "block" do %>
        <%= image_tag image.variant(resize_to_limit: [800, 600]), 
                      class: "w-full h-64 object-cover", 
                      alt: title %>
      <% end %>
    <% else %>
      <%= link_to path, class: "block bg-gray-300 h-64 flex items-center justify-center" do %>
        <i class="<%= is_collection ? 'ri-folder-line' : 'ri-image-line' %> text-6xl text-gray-500"></i>
      <% end %>
    <% end %>
  </div>

  <!-- Content -->
  <div class="p-4">
    <!-- Type Badge -->
    <div class="mb-2">
      <span class="inline-block bg-gray-900 text-white text-xs px-2 py-1 border border-gray-800 rounded-none">
        <%= is_collection ? 'COLLECTION' : 'ARTICLE' %>
      </span>
    </div>

    <!-- Title -->
    <h3 class="text-lg font-bold text-gray-800 mb-3 hover:text-gray-600 transition-colors">
      <%= link_to title, path, class: "hover:text-gray-600" %>
    </h3>

    <!-- Metadata -->
    <div class="flex flex-wrap items-center gap-3 text-sm text-gray-600 border-t border-gray-300 pt-3">
      <% if is_article %>
        <!-- Date -->
        <div class="flex items-center gap-1">
          <i class="ri-calendar-line"></i>
          <span><%= item.published_at&.strftime("%d/%m/%Y") || item.created_at.strftime("%d/%m/%Y") %></span>
        </div>

        <!-- Author -->
        <div class="flex items-center gap-1">
          <i class="ri-user-line"></i>
          <%= link_to item.user.username.upcase, profile_path(item.user.username), class: "hover:text-gray-800" %>
        </div>

        <!-- Tags -->
        <% if item.tags.any? %>
          <div class="flex items-center gap-1">
            <i class="ri-price-tag-3-line"></i>
            <span><%= item.tags.first.name.upcase %></span>
          </div>
        <% end %>
      <% else %>
        <!-- Collection stats -->
        <div class="flex items-center gap-1">
          <i class="ri-folder-line"></i>
          <span><%= item.collection_items.count %> items</span>
        </div>

        <!-- Author -->
        <div class="flex items-center gap-1">
          <i class="ri-user-line"></i>
          <%= link_to item.user.username.upcase, profile_path(item.user.username), class: "hover:text-gray-800" %>
        </div>
      <% end %>
    </div>
  </div>
</article>
