<nav class="bg-gray-200 border-b border-gray-800 p-4">
  <div class="max-w-screen-2xl mx-auto flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <!-- Logo/Brand -->
    <div class="flex items-center">
      <%= link_to root_path, class: "text-2xl md:text-4xl font-bold text-gray-800 tracking-tight hover:text-gray-600 transition-colors" do %>
        <span style="font-family: 'Gridlite PE', monospace;">RNDMLAB</span>
      <% end %>
    </div>

    <!-- Navigation Links -->
    <div class="flex flex-wrap items-center gap-6 text-sm md:text-base">
      <%= link_to "Статьи", articles_path, class: "text-gray-800 hover:text-gray-600 transition-colors font-medium" %>
      <%= link_to "Коллекции", collections_path, class: "text-gray-800 hover:text-gray-600 transition-colors font-medium" %>
      <%= link_to "О проекте", "#", class: "text-gray-800 hover:text-gray-600 transition-colors font-medium" %>
      <%= link_to "Ресурсы", "#", class: "text-gray-800 hover:text-gray-600 transition-colors font-medium" %>
      
      <% if user_signed_in? && current_user.admin? %>
        <%= link_to "Admin", admin_root_path, class: "text-red-600 hover:text-red-700 transition-colors font-medium" %>
      <% end %>
    </div>

    <!-- Auth Section -->
    <div class="flex items-center gap-4">
      <% if user_signed_in? %>
        <%= link_to new_article_path, class: "text-gray-800 hover:text-gray-600 transition-colors font-medium flex items-center gap-1" do %>
          <i class="ri-article-line"></i>
          <span>Новая статья</span>
        <% end %>
        <%= link_to new_collection_path, class: "text-gray-800 hover:text-gray-600 transition-colors font-medium flex items-center gap-1" do %>
          <i class="ri-folder-add-line"></i>
          <span>Новая коллекция</span>
        <% end %>
        <%= link_to profile_path(current_user.username), class: "bg-gray-900 text-white px-4 py-2 border border-gray-800 rounded-none hover:bg-gray-700 transition-colors text-sm font-medium flex items-center gap-2" do %>
          <i class="ri-user-line"></i>
          <span>@<%= current_user.username %></span>
        <% end %>
      <% else %>
        <%= link_to "Войти", new_user_session_path, class: "text-gray-800 hover:text-gray-600 transition-colors font-medium" %>
        <%= link_to "Подписаться", new_user_registration_path, class: "bg-gray-900 text-white px-6 py-2 border border-gray-800 rounded-none hover:bg-gray-700 transition-colors text-sm font-medium inline-block" %>
      <% end %>
    </div>
  </div>
</nav>
